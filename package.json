{
  "name": "ritmo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=file:./unit.db prisma db push && DATABASE_URL=file:./unit.db node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:cleanup": "node --import tsx tests/cleanup.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@google/genai": "^1.30.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "node": "^22.23.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
